{
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "node",
    "target": "ES2020",
    "checkJs": true,
    "strict": true,
    "baseUrl": "./src",
    "paths": {
      "@client/*": ["client/*"],
      "@services/*": ["services/*"],
      "@helpers/*": ["helpers/*"],
      "@types/*": ["types/*"]
    }
  },
  "include": ["src/**/*.js"],
  "exclude": ["node_modules", "dist"]
}
