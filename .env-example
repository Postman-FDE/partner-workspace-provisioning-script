# =============================================================================
# Partner Workspace Provisioning - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values
# 
# These variables work for both:
#   - CLI scripts (provision.js, reset.js)
#   - Web library (postmanService.js)
# =============================================================================

# =============================================================================
# REQUIRED: Postman API Configuration
# =============================================================================

# Your Postman API key (required)
# Get your API key from: https://web.postman.co/settings/me/api-keys
POSTMAN_API_KEY=PMAK-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Source workspace ID to copy assets from (required)
# Find your workspace ID in Postman: Workspace Settings > Workspace ID
POSTMAN_SOURCE_WORKSPACE_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# =============================================================================
# OPTIONAL: Target Workspace Configuration
# =============================================================================

# Target workspace ID (optional)
# If provided, assets will be copied to this existing workspace
# If not provided, a new workspace will be created
POSTMAN_TARGET_WORKSPACE_ID=

# Name for new workspace (optional, used if POSTMAN_TARGET_WORKSPACE_ID is not set)
# Default: "Partner Workspace"
POSTMAN_WORKSPACE_NAME=Partner Workspace

# =============================================================================
# OPTIONAL: Team Members & Partner Invitations
# =============================================================================

# Comma-separated list of Postman user IDs to add as workspace admins (optional)
# These users will be added as admins (role ID: 3) to the provisioned workspace
# Example: POSTMAN_ADMIN_USER_IDS=12345,67890,11111
POSTMAN_ADMIN_USER_IDS=

# Comma-separated list of partner emails to invite (optional)
# These partners will receive invitation links to join the workspace
# Example: PARTNER_EMAILS=partner1@company.com,partner2@company.com
PARTNER_EMAILS=

# Partner role ID (optional)
# Default: "7" (Editor and Partner Lead)
# Available roles:
#   - "4" = Partner Viewer (read-only access)
#   - "7" = Editor and Partner Lead (full partner access with editing)
PARTNER_ROLE_ID=7

# =============================================================================
# ROLE REFERENCE
# =============================================================================
# Workspace Roles:
#   - "1" = Viewer
#   - "2" = Editor  
#   - "3" = Admin
#
# Partner Roles:
#   - "4" = Partner Viewer
#   - "7" = Editor and Partner Lead
# =============================================================================
