		{
			"name": "Update Partner Role",
			"item": [
				{
					"name": "Get Workspace Roles",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"// Parse the JSON response",
									"const jsonData = pm.response.json();",
									"",
									"// Find the role object that has a \"partner\" array",
									"const partnerRole = jsonData.roles.find(role => role.partner && role.partner.length > 0);",
									"",
									"if (partnerRole) {",
									"    // Extract the partnerId (first element of the partner array)",
									"    const partnerId = partnerRole.partner[0];",
									"    ",
									"    // Extract the roleId from the role object's \"id\" field",
									"    const currentRoleId = partnerRole.id;",
									"    ",
									"    // Set as environment variables",
									"    pm.environment.set(\"partnerUserId\", partnerId);",
									"    pm.environment.set(\"currentRoleId\", currentRoleId);",
									"    ",
									"    // Log the extracted values for verification",
									"    console.log(\"Partner ID extracted:\", partnerId);",
									"    console.log(\"Current Role ID extracted:\", currentRoleId);",
									"    console.log(\"Variables set successfully!\");",
									"} else {",
									"    console.log(\"No partner role found in the response\");",
									"}"
								],
								"type": "text/javascript",
								"packages": {},
								"requests": {}
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/workspaces/{{workspaceId}}/roles",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"workspaces",
								"{{workspaceId}}",
								"roles"
							]
						},
						"description": "Gets all roles assigned in a workspace. Returns userId of partners and their role IDs."
					},
					"response": []
				},
				{
					"name": "Update Partner Role",
					"request": {
						"method": "PATCH",
						"header": [
							{
								"key": "X-API-Key",
								"value": "{{x-api-key}}"
							},
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"roles\": [\n        {\n            \"op\": \"add\",\n            \"path\": \"/partner\",\n            \"value\": [\n                {\n                    \"id\": \"{{partnerUserId}}\",\n                    \"role\": \"7\"\n                }\n            ]\n        },\n        {\n            \"op\": \"remove\",\n            \"path\": \"/partner\",\n            \"value\": [\n                {\n                    \"id\": \"{{partnerUserId}}\",\n                    \"role\": \"{{currentRoleId}}\"\n                }\n            ]\n        }\n    ]\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{baseUrl}}/workspaces/{{workspaceId}}/roles",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"workspaces",
								"{{workspaceId}}",
								"roles"
							]
						},
						"description": "Updates a partner's role in the workspace. Removes the old role and adds the new role (7). Requires partnerId and currentRoleId from the previous requests."
					},
					"response": []
				}
			]
		},
		{
