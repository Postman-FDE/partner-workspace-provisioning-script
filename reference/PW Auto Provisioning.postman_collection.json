								"exec": [
									"// Get the partner email from environment variable",
									"const partnerEmail = pm.environment.get(\"partnerEmail\");",
									"",
									"// Parse the JSON response",
									"const jsonData = pm.response.json();",
									"",
									"// Search through results array to find the matching email",
									"if (jsonData.results && Array.isArray(jsonData.results)) {",
									"    const matchingResult = jsonData.results.find(result => result.email === partnerEmail);",
									"    ",
									"    if (matchingResult && matchingResult.userId) {",
									"        pm.environment.set(\"partnerUserId\", matchingResult.userId);",
									"        console.log(\"partnerUserId set to:\", matchingResult.userId);",
									"    } else {",
									"        console.log(\"No matching result found for email:\", partnerEmail);",
									"    }",
									"} else {",
									"    console.log(\"Results array not found in response\");",
									"}"
								],
